<Window x:Class="Vograph.Dialogs.HomeworkDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Домашнее задание" Height="340" Width="440" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Obsidian}" FontFamily="{StaticResource BodyFont}">
    <Border Style="{StaticResource Card}" Margin="10">
        <StackPanel>
            <TextBlock x:Name="LblTitle" Text="ДОМАШНЕЕ ЗАДАНИЕ" Style="{StaticResource SectionLabel}"/>
            <TextBlock x:Name="SubjectText" Text="Предмет: —" Foreground="{StaticResource MarbleDim}" FontSize="10" Margin="0,6,0,0"/>
            <TextBlock x:Name="LblHwText" Text="Текст задания" Foreground="{StaticResource Marble}" FontSize="11" Margin="0,10,0,4"/>
            <TextBox x:Name="TxtHomework" Tag="Что задано?" Height="70" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
            <TextBlock x:Name="LblHwN" Text="Через сколько занятий этого предмета сдать (1..10)" Foreground="{StaticResource Marble}" FontSize="11" Margin="0,8,0,4"/>
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="TxtN" Width="50" Text="1" Margin="0,0,8,0"/>
                <TextBlock x:Name="DuePreview" Text="Срок: —" Foreground="{StaticResource Bronze}" FontSize="10" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="LblHwHint" Text="Статус: far (скрыт) → approaching (серый) → burning (яркий)" Foreground="{StaticResource MarbleDim}" FontSize="9" Margin="0,6,0,0" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="BtnCancel" Content="Отмена" Style="{StaticResource GhostButton}" Click="Cancel_Click" Margin="0,0,6,0"/>
                <Button x:Name="BtnSave" Content="Сохранить" Style="{StaticResource FerryButton}" Click="Save_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
