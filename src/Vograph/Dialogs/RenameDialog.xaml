<Window x:Class="Vograph.Dialogs.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Переименование" Height="300" Width="420" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Obsidian}" FontFamily="{StaticResource BodyFont}">
    <Border Style="{StaticResource Card}" Margin="10">
        <StackPanel>
            <TextBlock x:Name="LblTitle" Text="ПЕРЕИМЕНОВАНИЕ" Style="{StaticResource SectionLabel}"/>
            <TextBlock x:Name="OriginalText" Text="Оригинал: —" Foreground="{StaticResource MarbleDim}" FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap"/>
            <TextBlock x:Name="LblNewName" Text="Новое название" Foreground="{StaticResource Marble}" FontSize="11" Margin="0,10,0,4"/>
            <TextBox x:Name="TxtDisplayName" Tag="Введите новое название" Background="{StaticResource PanelAlt}" Foreground="{StaticResource Marble}" BorderBrush="{StaticResource BorderDim}" CaretBrush="{StaticResource Bronze}"/>
            <TextBlock x:Name="LblFootnote" Text="Примечание (сноска)" Foreground="{StaticResource Marble}" FontSize="11" Margin="0,8,0,4"/>
            <TextBox x:Name="TxtNote" Tag="Необязательно" Height="40" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Background="{StaticResource PanelAlt}" Foreground="{StaticResource Marble}" BorderBrush="{StaticResource BorderDim}" CaretBrush="{StaticResource Bronze}"/>
            <TextBlock x:Name="LblScope" Text="Область" Foreground="{StaticResource Marble}" FontSize="11" Margin="0,8,0,4"/>
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="RbGlobal" Content="Глобально (все вхождения предмета)" Foreground="{StaticResource Marble}" FontSize="11" IsChecked="True" Margin="0,0,12,0"/>
                <RadioButton x:Name="RbWeekday" Content="Только в этот день" Foreground="{StaticResource Marble}" FontSize="11"/>
            </StackPanel>
            <TextBlock x:Name="PreviewText" Text="Предпросмотр: —" Foreground="{StaticResource Bronze}" FontSize="10" Margin="0,6,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="BtnReset" Content="Сбросить" Style="{StaticResource GhostButton}" Click="Reset_Click" Margin="0,0,6,0"/>
                <Button x:Name="BtnCancel" Content="Отмена" Style="{StaticResource GhostButton}" Click="Cancel_Click" Margin="0,0,6,0"/>
                <Button x:Name="BtnSave" Content="Сохранить" Style="{StaticResource FerryButton}" Click="Save_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
