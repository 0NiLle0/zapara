<Window x:Class="Vograph.Dialogs.TeacherFinderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Преподаватели" Height="640" Width="780" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Obsidian}" FontFamily="{StaticResource BodyFont}">
    <Border Style="{StaticResource Card}" Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock x:Name="LblTitle" Text="ПРЕПОДАВАТЕЛИ" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                <TextBlock x:Name="LblGroup" Text="Группа —" Foreground="{StaticResource MarbleDim}" FontSize="10" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <TextBlock x:Name="LblCount" Text="" Foreground="{StaticResource Bronze}" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>
            <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="TxtSearch" Grid.Column="0" Height="24" Background="{StaticResource PanelAlt}" Foreground="{StaticResource Marble}" BorderBrush="{StaticResource BorderDim}" CaretBrush="{StaticResource Bronze}" Tag="Поиск по преподавателю или предмету..." TextChanged="Search_TextChanged" VerticalContentAlignment="Center" Padding="6,0"/>
                <ComboBox x:Name="CmbSubjectFilter" Grid.Column="1" Height="24" Margin="8,0,0,0" SelectionChanged="SubjectFilter_Changed" IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True" ToolTip="Введите текст для поиска предмета">
                    <ComboBox.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding}" Foreground="{StaticResource Marble}"/></DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <CheckBox x:Name="ChkOnlyMy" Grid.Column="2" Content="Только мои" Foreground="{StaticResource Marble}" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0" IsChecked="True" Checked="OnlyMy_Changed" Unchecked="OnlyMy_Changed" ToolTip="Показывать только преподавателей, которые ведут у вашей группы"/>
            </Grid>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <!-- Teacher list -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="TeacherListPanel" Margin="6"/>
                    </ScrollViewer>
                </Border>
                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" ShowsPreview="False" ResizeDirection="Columns"/>
                <!-- Details -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="8" Margin="0,0,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="DetailsPanel">
                            <TextBlock x:Name="DetailsPlaceholder" Text="Выберите преподавателя слева" Foreground="{StaticResource MarbleDim}" FontSize="11" Margin="0,20" HorizontalAlignment="Center" TextAlignment="Center"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="BtnClose" Content="Закрыть" Style="{StaticResource FerryButton}" Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
