<Window x:Class="Vograph.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Военмех - расписание и карты" Height="820" Width="1360" MinHeight="640" MinWidth="1180"
        Background="{StaticResource Obsidian}"
        FontFamily="{StaticResource BodyFont}"
        WindowStartupLocation="CenterScreen">
    <Grid x:Name="RootLayer" Focusable="True" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Obsidian}" BorderBrush="{StaticResource Bronze}" BorderThickness="0,0,0,1" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="LeftPanelToggle" Content="≡" Style="{StaticResource GhostButton}" Padding="0" FontSize="19" Width="34" Height="34" Margin="0,0,14,0" VerticalAlignment="Center" ToolTip="Menu" Visibility="Collapsed"/>
                        <TextBlock Text="Военмех - расписание и карты" Style="{StaticResource Title}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="HeaderHint" Text="Группа — · —" Foreground="{StaticResource MarbleDim}" FontSize="10" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="ElevationHint" Text="Расписание Военмеха · завтра по умолчанию" Style="{StaticResource Dim}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
                <ToggleButton x:Name="SettingsButton" Grid.Column="1" Content="⚙" Style="{StaticResource GearButton}" VerticalAlignment="Top" ToolTip="Settings"/>
                <Popup IsOpen="{Binding IsChecked, ElementName=SettingsButton, Mode=TwoWay}" PlacementTarget="{Binding ElementName=SettingsButton}" Placement="Bottom" HorizontalOffset="-340" VerticalOffset="6" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Focusable="False">
                    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Bronze}" BorderThickness="1" CornerRadius="3" Padding="0" Width="360" MaxHeight="620">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                        <StackPanel>
                            <TextBlock x:Name="TxtSettingsTitle" Text="НАСТРОЙКИ" Style="{StaticResource SectionLabel}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock x:Name="LblLanguage" Text="Язык" Foreground="{StaticResource Marble}" FontSize="11" VerticalAlignment="Center"/>
                                <ComboBox x:Name="LanguagePicker" Width="140" Height="24" Margin="8,0,0,0" SelectionChanged="LanguagePicker_Changed">
                                    <ComboBoxItem Content="Русский" Tag="ru"/>
                                    <ComboBoxItem Content="English" Tag="en"/>
                                </ComboBox>
                            </StackPanel>
                            <TextBlock x:Name="LblMyGroup" Text="Моя группа" Style="{StaticResource Dim}" Margin="0,8,0,0"/>
                            <ComboBox x:Name="SettingsGroupPicker" Margin="0,4,0,0" Height="26" IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True" TextSearch.TextPath="Name" ToolTip="Введите текст для поиска группы">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource Marble}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <CheckBox x:Name="ChkInvertParity" Content="Инвертировать четность недели" Foreground="{StaticResource Marble}" FontSize="11" Margin="0,10,0,0"/>
                            <TextBlock x:Name="TxtInvertHint" Text="Если вуз сдвинул неделю, включите инверсию." Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <Border Height="1" Background="{StaticResource BorderDim}" Margin="0,12,0,0" Opacity="0.5"/>
                            <TextBlock x:Name="LblFriendsTitle" Text="ДРУЗЬЯ (до 5)" Style="{StaticResource SectionLabel}" Margin="0,12,0,0"/>
                            <StackPanel x:Name="FriendsListPanel" Margin="0,6,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <ComboBox x:Name="FriendGroupPicker" Width="180" Height="24" Margin="0,0,6,0" IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True" TextSearch.TextPath="Name" ToolTip="Введите текст для поиска группы">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource Marble}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button x:Name="BtnAddFriend" Content="+ Добавить" Style="{StaticResource GhostButton}" Click="AddFriend_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtFriendsHint" Text="Цвет — один из 5, иконка внутри ячейки. Справа от группы — имена товарищей." Style="{StaticResource Dim}" FontSize="9" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            <CheckBox x:Name="ChkAlwaysShowTraffic" Content="Всегда показывать все светофоры (пустые — погасшие)" Foreground="{StaticResource Marble}" FontSize="10" Margin="0,8,0,0" Checked="ChkAlwaysShowTraffic_Changed" Unchecked="ChkAlwaysShowTraffic_Changed" ToolTip="Если включено — всегда столько, сколько выбрано (до 5), пустые — потухший. Если выключено — только непустые (как раньше)."/>
                            <TextBlock x:Name="LblStrictnessTitle" Text="Строгость пересечений" Style="{StaticResource Dim}" Margin="0,8,0,0" Visibility="Collapsed"/>
                            <Slider x:Name="StrictnessSlider" Minimum="0" Maximum="100" Value="50" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="Strictness_Changed" Margin="0,4,0,0" Visibility="Collapsed"/>
                            <Grid x:Name="StrictnessGrid" Margin="0,2,0,0" Visibility="Collapsed">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="TxtStrict0" Text="0 — любое время" Foreground="{StaticResource MarbleDim}" FontSize="9" Grid.Column="0"/>
                                <TextBlock x:Name="TxtStrict40" Text="40 — корпус" Foreground="{StaticResource MarbleDim}" FontSize="9" Grid.Column="1" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtStrict100" Text="100 — аудитория" Foreground="{StaticResource MarbleDim}" FontSize="9" Grid.Column="2" HorizontalAlignment="Right"/>
                            </Grid>
                            <TextBlock x:Name="StrictnessLabel" Text="50 — корпус" Foreground="{StaticResource Bronze}" FontSize="10" Margin="0,2,0,0" Visibility="Collapsed"/>
                            <Border Height="1" Background="{StaticResource BorderDim}" Margin="0,12,0,0" Opacity="0.5"/>
                            <TextBlock x:Name="LblBlockWidthTitle" Text="ШИРИНА БЛОКОВ" Style="{StaticResource SectionLabel}" Margin="0,12,0,0" Visibility="Collapsed"/>
                            <TextBlock x:Name="TxtBlockWidthHint" Text="Тяните разделитель между расписанием и картой или двигайте ползунок. Все блоки подстраиваются." Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="9" Visibility="Collapsed"/>
                            <Slider x:Name="BlockWidthSlider" Minimum="240" Maximum="620" Value="300" TickFrequency="20" IsSnapToTickEnabled="True" ValueChanged="BlockWidth_Changed" Margin="0,6,0,0" Visibility="Collapsed"/>
                            <Grid Margin="0,2,0,0" Visibility="Collapsed">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="240 узкая" Foreground="{StaticResource MarbleDim}" FontSize="9" Grid.Column="0"/>
                                <TextBlock x:Name="BlockWidthLabel" Text="300" Foreground="{StaticResource Bronze}" FontSize="10" Grid.Column="1" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                                <TextBlock Text="620 широкая" Foreground="{StaticResource MarbleDim}" FontSize="9" Grid.Column="2" HorizontalAlignment="Right"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="Collapsed">
                                <Button x:Name="BtnBlockWidthReset" Content="Сбросить 300" Style="{StaticResource GhostButton}" Padding="6,2" FontSize="10" Click="BlockWidthReset_Click"/>
                                <Button x:Name="BtnBlockWidthWide" Content="На всю ширину" Style="{StaticResource GhostButton}" Padding="6,2" FontSize="10" Margin="6,0,0,0" Click="BlockWidthWide_Click" ToolTip="Сделать карту на всю ширину окна"/>
                            </StackPanel>
                            <Border Height="1" Background="{StaticResource BorderDim}" Margin="0,12,0,0" Opacity="0.5" Visibility="Collapsed"/>
                            <TextBlock x:Name="LblNotificationsTitle" Text="УВЕДОМЛЕНИЯ" Style="{StaticResource SectionLabel}" Margin="0,12,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock x:Name="LblTime1" Text="Время 1" Foreground="{StaticResource Marble}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="NotifyTime1Box" Width="60" Height="22" Tag="20:00" Margin="0,0,6,0" Background="{StaticResource PanelAlt}" Foreground="{StaticResource Marble}" BorderBrush="{StaticResource BorderDim}" CaretBrush="{StaticResource Bronze}"/>
                                <TextBlock x:Name="LblTime2" Text="Время 2" Foreground="{StaticResource Marble}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="NotifyTime2Box" Width="60" Height="22" Tag="07:30" Background="{StaticResource PanelAlt}" Foreground="{StaticResource Marble}" BorderBrush="{StaticResource BorderDim}" CaretBrush="{StaticResource Bronze}"/>
                            </StackPanel>
                            <Button x:Name="BtnSaveTimes" Content="Сохранить времена" Style="{StaticResource GhostButton}" Click="SaveNotifyTimes_Click" Margin="0,6,0,0" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="TxtNotifHint" Text="Текст использует переименованные названия и помечает горящее ДЗ." Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="9"/>
                            <Border Height="1" Background="{StaticResource BorderDim}" Margin="0,12,0,0" Opacity="0.5"/>
                            <TextBlock x:Name="LblSyncTitle" Text="СИНХРОНИЗАЦИЯ" Style="{StaticResource SectionLabel}" Margin="0,10,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button x:Name="BtnExport" Content="Экспорт" Style="{StaticResource GhostButton}" Click="Export_Click"/>
                                <Button x:Name="BtnImport" Content="Импорт" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Click="Import_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="LastUpdatedText" Text="Обновлено: —" Style="{StaticResource Dim}" Margin="0,8,0,0"/>
                            <TextBlock x:Name="LastAutoCheckText" Text="Автопроверка: —" Style="{StaticResource Dim}" Margin="0,2,0,0" FontSize="9"/>
                            <Button x:Name="BtnRefreshSettings" Content="Обновить расписание" Style="{StaticResource FerryButton}" Margin="0,10,0,0" Click="Refresh_Click"/>
                            <CheckBox x:Name="ChkAutoUpdate" Content="Автообновление с GitHub" Foreground="{StaticResource Marble}" FontSize="11" Margin="0,8,0,0" Checked="ChkAutoUpdate_Changed" Unchecked="ChkAutoUpdate_Changed" ToolTip="Само скачивает релиз с GitHub и предлагает перезапуск"/>
                            <Button x:Name="BtnCheckUpdate" Content="Проверить обновление (GitHub)" Style="{StaticResource GhostButton}" Margin="0,6,0,0" Click="CheckUpdate_Click" ToolTip="Скачать релиз с github.com/0NiLle0/zapara и перезапуститься"/>
                        </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="10,10,10,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LblGroup" Text="ГРУППА" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="GroupPicker" Grid.Column="1" MinWidth="180" MaxWidth="260" HorizontalAlignment="Left" SelectionChanged="GroupPicker_Changed" IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True" TextSearch.TextPath="Name" ToolTip="Введите текст для поиска группы">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource Marble}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnRefresh" Content="Обновить" Style="{StaticResource GhostButton}" Click="Refresh_Click" Margin="0,0,6,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                <Button x:Name="BtnYesterday" Content="Вчера" Style="{StaticResource GhostButton}" Width="110" Click="TabYesterday_Click"/>
                <Button x:Name="BtnToday" Content="Сегодня" Style="{StaticResource GhostButton}" Width="110" Margin="8,0,0,0" Click="TabToday_Click"/>
                <Button x:Name="BtnTomorrow" Content="Завтра" Style="{StaticResource FerryButton}" Width="110" Margin="8,0,0,0" Click="TabTomorrow_Click"/>
                <Button x:Name="BtnWeek" Content="Неделя" Style="{StaticResource GhostButton}" Width="110" Margin="8,0,0,0" Click="TabWeek_Click"/>
                <Button x:Name="BtnSummary" Content="Сводка" Style="{StaticResource GhostButton}" Width="110" Margin="8,0,0,0" Click="TabSummary_Click"/>
                <Button x:Name="BtnTeachers" Content="Преподаватели" Style="{StaticResource GhostButton}" Width="130" Margin="8,0,0,0" Click="Teachers_Click"/>
                <Button x:Name="BtnMapToggle" Content="Карта" Style="{StaticResource GhostButton}" Width="110" Margin="8,0,0,0" Click="ToggleMap_Click" ToolTip="Показать/скрыть карты (поиск по корпусам)"/>
                <TextBlock x:Name="DateHeader" Text="—" Foreground="{StaticResource MarbleDim}" FontSize="11" VerticalAlignment="Center" Margin="16,0,0,0"/>
                <Border x:Name="ParityBadge" Background="{StaticResource PanelAlt}" BorderBrush="{StaticResource BorderDim}" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="ParityText" Text="—" Foreground="{StaticResource Bronze}" FontSize="10" FontWeight="SemiBold"/>
                </Border>
                <TextBlock x:Name="WeekNumberText" Text="" Foreground="{StaticResource MarbleDim}" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0" ToolTip="Номер учебной недели с 1 сентября"/>
            </StackPanel>
            <StackPanel x:Name="WeekParityPanel" Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8" Visibility="Collapsed">
                <TextBlock x:Name="LblWeek" Text="Неделя:" Foreground="{StaticResource MarbleDim}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button x:Name="BtnWeekOdd" Content="Нечетная" Style="{StaticResource GhostButton}" Padding="10,4" Click="WeekOdd_Click"/>
                <Button x:Name="BtnWeekEven" Content="Четная" Style="{StaticResource GhostButton}" Padding="10,4" Margin="6,0,0,0" Click="WeekEven_Click"/>
            </StackPanel>
            <Grid x:Name="MainContentGrid" Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="SplitterColumn" Width="6"/>
                    <ColumnDefinition x:Name="MapColumn" Width="300"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,0,0" Padding="0">
                    <Grid>
                        <ScrollViewer x:Name="ScheduleScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="7">
                            <StackPanel x:Name="SchedulePanel">
                                <TextBlock x:Name="EmptyText" Text="Нет занятий" Foreground="{StaticResource MarbleDim}" HorizontalAlignment="Center" Margin="0,30" Visibility="Collapsed"/>
                            </StackPanel>
                        </ScrollViewer>
                        <ScrollViewer x:Name="WeekScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="7" Visibility="Collapsed">
                            <Grid x:Name="WeekGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>
                <GridSplitter x:Name="MapSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" BorderThickness="0"
                              ShowsPreview="False" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Cursor="SizeWE"
                              DragCompleted="MapSplitter_DragCompleted" Visibility="Collapsed">
                    <GridSplitter.Template>
                        <ControlTemplate TargetType="GridSplitter">
                            <Border Background="{StaticResource BorderDim}" CornerRadius="1" Margin="2,0" Opacity="0.5">
                                <Border x:Name="grip" Width="2" Background="{StaticResource BorderDim}" HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="0,40"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="grip" Property="Background" Value="{StaticResource Bronze}"/>
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="grip" Property="Background" Value="{StaticResource Bronze}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </GridSplitter.Template>
                </GridSplitter>
                <!-- Map panel: next lesson map from voenmeh.ru/openmap -->
                <Border x:Name="MapPanel" Grid.Column="2" Style="{StaticResource Card}" Padding="7" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock x:Name="LblMapTitle" Text="КАРТА" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="MapNextBadge" Text="следующая пара" Foreground="{StaticResource Bronze}" FontSize="9" VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="0,0,0,6">
                            <TextBlock x:Name="MapWhereText" Text="Куда: —" Foreground="{StaticResource Marble}" FontSize="11" TextWrapping="Wrap" FontWeight="SemiBold"/>
                            <TextBlock x:Name="MapWhenText" Text="Когда: —" Foreground="{StaticResource MarbleDim}" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            <TextBlock x:Name="MapNoteText" Text="" Foreground="{StaticResource Bronze}" FontSize="9" TextWrapping="Wrap" Margin="0,2,0,0" FontStyle="Italic" Visibility="Collapsed"/>
                        </StackPanel>
                        <Border Grid.Row="2" Background="{StaticResource Obsidian}" BorderBrush="{StaticResource BorderDim}" BorderThickness="1" CornerRadius="3" Padding="0" Margin="0,0,0,6" MinHeight="180">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <!-- Zoomable map viewer -->
                                <Border Grid.Row="0" ClipToBounds="True" CornerRadius="3,3,0,0" Background="#FF0E1013" MinHeight="160">
                                    <Grid>
                                        <ScrollViewer x:Name="MapScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PanningMode="Both" Background="Transparent"
                                                      PreviewMouseWheel="MapScrollViewer_MouseWheel" PreviewMouseLeftButtonDown="MapScrollViewer_MouseDown" PreviewMouseMove="MapScrollViewer_MouseMove" PreviewMouseLeftButtonUp="MapScrollViewer_MouseUp">
                                            <Grid x:Name="MapViewGrid" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Grid.LayoutTransform><ScaleTransform x:Name="MapScale" ScaleX="1" ScaleY="1"/></Grid.LayoutTransform>
                                                <Image x:Name="MapImage" Stretch="None" RenderOptions.BitmapScalingMode="Fant" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="MapImage_MouseDown"/>
                                                <!-- Highlight overlay for cabinet — now using coords.json -->
                                                <Canvas x:Name="MapOverlay" IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                    <Border x:Name="MapHighlight" Visibility="Collapsed" BorderBrush="{StaticResource Bronze}" BorderThickness="2.5" CornerRadius="6" Background="#286CA5E0" Padding="0" Canvas.Left="0" Canvas.Top="0">
                                                        <Border.Effect><DropShadowEffect Color="#FF6CA5E0" BlurRadius="14" ShadowDepth="0" Opacity="0.75"/></Border.Effect>
                                                        <Grid>
                                                            <TextBlock x:Name="MapHighlightLabel" Text="320" Foreground="White" FontSize="13" FontWeight="Bold" Margin="8,4" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                    <Ellipse x:Name="MapPulse" Width="18" Height="18" Stroke="{StaticResource Bronze}" StrokeThickness="2" Fill="#4D6CA5E0" Visibility="Collapsed" IsHitTestVisible="False" Canvas.Left="0" Canvas.Top="0">
                                                        <Ellipse.Effect><DropShadowEffect Color="#FF6CA5E0" BlurRadius="10" ShadowDepth="0" Opacity="0.85"/></Ellipse.Effect>
                                                    </Ellipse>
                                                </Canvas>
                                            </Grid>
                                        </ScrollViewer>
                                        <!-- Placeholder / loading on top of viewer -->
                                        <TextBlock x:Name="MapPlaceholder" Text="Карта не выбрана — выберите пару или группу" Foreground="{StaticResource MarbleDim}" FontSize="10" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12" TextAlignment="Center" IsHitTestVisible="False"/>
                                        <Border x:Name="MapLoadingOverlay" Background="#AA0E1013" Visibility="Collapsed" CornerRadius="3" IsHitTestVisible="False">
                                            <TextBlock Text="Загрузка карты..." Foreground="{StaticResource Marble}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10"/>
                                        </Border>
                                        <!-- Hint for zoom -->
                                        <TextBlock Text="колесо — зум, перетаскивание — панорама, двойной клик — 100%" Foreground="#FF6B7280" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6" Opacity="0.6" IsHitTestVisible="False"/>
                                    </Grid>
                                </Border>
                                <!-- Zoom toolbar -->
                                <Border Grid.Row="1" Background="{StaticResource PanelAlt}" BorderBrush="{StaticResource BorderDim}" BorderThickness="0,1,0,0" CornerRadius="0,0,3,3" Padding="4,3">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <Button x:Name="BtnZoomOut" Content="−" Style="{StaticResource GhostButton}" Width="26" Height="22" Padding="0" FontSize="14" Click="ZoomOut_Click" ToolTip="Уменьшить"/>
                                            <Button x:Name="BtnZoomIn" Content="+" Style="{StaticResource GhostButton}" Width="26" Height="22" Padding="0" FontSize="14" Margin="4,0,0,0" Click="ZoomIn_Click" ToolTip="Увеличить"/>
                                            <Button x:Name="BtnZoomFit" Content="⊡" Style="{StaticResource GhostButton}" Width="26" Height="22" Padding="0" FontSize="11" Margin="4,0,0,0" Click="ZoomFit_Click" ToolTip="Вписать"/>
                                            <Button x:Name="BtnZoom100" Content="100%" Style="{StaticResource GhostButton}" Width="40" Height="22" Padding="0" FontSize="10" Margin="4,0,0,0" Click="ZoomReset_Click" ToolTip="1:1"/>
                                            <Button x:Name="BtnMapFullscreen" Content="⛶" Style="{StaticResource GhostButton}" Width="26" Height="22" Padding="0" FontSize="12" Margin="4,0,0,0" Click="MapFullscreen_Click" ToolTip="Развернуть карту на весь экран (Esc — назад)"/>
                                        </StackPanel>
                                        <Slider x:Name="ZoomSlider" Grid.Column="1" Minimum="0.4" Maximum="3.0" Value="1.0" Margin="8,0" VerticalAlignment="Center" TickFrequency="0.1" IsSnapToTickEnabled="False" ValueChanged="ZoomSlider_Changed" SmallChange="0.1" LargeChange="0.2"/>
                                        <TextBlock x:Name="ZoomLabel" Grid.Column="2" Text="100%" Foreground="{StaticResource MarbleDim}" FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0" MinWidth="36" TextAlignment="Right"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="190">
                            <StackPanel>
                                <TextBlock x:Name="LblMapAll" Text="Все карты" Foreground="{StaticResource MarbleDim}" FontSize="9" Margin="0,0,0,4"/>
                                <ComboBox x:Name="MapPicker" Height="24" SelectionChanged="MapPicker_Changed" IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True" TextSearch.TextPath="Title" ToolTip="Введите текст для поиска карты (ГК/УЛК)"/>
                                <TextBlock x:Name="TxtMapHint" Text="Карты с voenmeh.ru/openmap — ГК 1-4, УЛК 1-5; встроены в приложение, работают офлайн" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="9"/>
                                <TextBlock x:Name="MapCacheText" Text="Кэш: —" Style="{StaticResource Dim}" Margin="0,4,0,0" FontSize="9"/>
                                <TextBlock x:Name="MapOfflineStatus" Text="Офлайн: проверка..." Foreground="{StaticResource Patina}" FontSize="9" Margin="0,3,0,0" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <ProgressBar x:Name="MapDownloadProgress" Height="4" Minimum="0" Maximum="9" Value="0" Margin="0,6,0,0" Visibility="Collapsed" Foreground="{StaticResource Bronze}" Background="{StaticResource BorderDim}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button x:Name="BtnOpenMapsFolder" Content="📁 Папка" Style="{StaticResource GhostButton}" Padding="6,2" FontSize="10" Click="OpenMapsFolder_Click" ToolTip="Открыть папку кэша карт"/>
                                    <Button x:Name="BtnVerifyOffline" Content="Проверить офлайн" Style="{StaticResource GhostButton}" Padding="6,2" FontSize="10" Margin="6,0,0,0" Click="VerifyOffline_Click" ToolTip="Проверить наличие всех карт для офлайна"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,6,0,0">
                            <Button x:Name="BtnMapOpen" Content="Открыть полностью" Style="{StaticResource GhostButton}" Padding="8,3" FontSize="10" Click="MapOpen_Click"/>
                            <Button x:Name="BtnMapSite" Content="На сайте" Style="{StaticResource GhostButton}" Padding="8,3" FontSize="10" Margin="6,0,0,0" Click="MapSite_Click"/>
                            <Button x:Name="BtnMapDownload" Content="Скачать для офлайна" Style="{StaticResource GhostButton}" Padding="8,3" FontSize="10" Margin="6,0,0,0" Click="MapDownload_Click" ToolTip="Скопировать встроенные карты в кэш и/или докачать недостающие — после этого работает без интернета"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
            <!-- Summary overlay: week / 2 weeks breakdown -->
            <Border x:Name="SummaryPanel" Grid.Row="3" Style="{StaticResource Card}" Padding="12" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock x:Name="LblSummaryTitle" Text="СВОДКА" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SummaryGroupText" Text="—" Foreground="{StaticResource MarbleDim}" FontSize="10" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        <Button Content="✕" Style="{StaticResource GhostButton}" Padding="6,2" FontSize="10" Margin="12,0,0,0" Click="CloseSummary_Click" ToolTip="Закрыть"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="SummaryStack">
                            <!-- generated in code: 3 sections odd/even/both -->
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
            <Border Grid.Row="4" Margin="0,6,0,0" Background="Transparent">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="StatusText" Text="Готово" Style="{StaticResource Dim}" />
                    <TextBlock x:Name="StaleBadge" Text=" · устаревшие данные" Foreground="{StaticResource Cinnabar}" FontSize="10" FontWeight="SemiBold" Visibility="Collapsed" Margin="6,0,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
